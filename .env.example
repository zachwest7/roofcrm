NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only key for internal MVP writes before Supabase Auth is enabled.
# Never expose this as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Optional future providers.
# Used for Google Address Validation and Solar API server calls.
GOOGLE_MAPS_API_KEY=

# Optional browser-restricted key if we add Google Maps UI later.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional map imagery for reviewer context.
MAPBOX_ACCESS_TOKEN=

# Optional premium imagery/DSM provider.
NEARMAP_API_KEY=
